# ─── Required ───────────────────────────────────────────────────────────────
# PostgreSQL (Prisma 7 + driver adapter over `pg`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myfragrancehub"

# Public site origin — NO trailing slash. Used for metadata, canonicals,
# sitemap, and server-side tRPC. In production set to your real https URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin JWT signing secret — min 16 characters. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-min-16-chars"

# ─── Optional ───────────────────────────────────────────────────────────────
# PgBouncer / Neon direct URL for migrations only (uncomment if your host documents it)
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/myfragrancehub"

# Dev server port (default 3000). NEXT_PUBLIC_SITE_URL should match when testing SSR.
# PORT=3000

# Set to 1 only if your reverse proxy or host already sends Content-Security-Policy
# (multiple CSP headers are combined with AND — duplicate policies can block Next dev).
# DISABLE_NEXT_CSP=1

# ─── Cloudflare R2 (product image uploads, S3-compatible API) ───────────────
# Public URL where objects are readable in a browser (https://pub-….r2.dev or your custom domain).
# Do NOT use *.r2.cloudflarestorage.com — that is the private S3 API; unauthenticated GETs return InvalidArgument/Authorization XML.
# No trailing slash.
# R2_PUBLIC_BASE_URL="https://assets.example.com"
# Cloudflare dashboard → R2 → bucket → S3 API (Account ID is in the endpoint URL).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
#
# Uploads go through this app (POST /api/admin/upload/product-image) → R2, so you do not need
# R2 CORS for the admin UI. (CORS on the bucket still matters if you load images from the browser
# from another origin, e.g. a separate marketing site.)
#
# For CSP + next/image, set R2_ACCOUNT_ID and R2_PUBLIC_BASE_URL at build/runtime as documented above.

# ─── Production deploy checklist ────────────────────────────────────────────
# - Set NEXT_PUBLIC_SITE_URL to your canonical https origin (no trailing slash).
#   On Vercel, VERCEL_URL is a fallback; elsewhere there is no fallback except localhost.
# - Set AUTH_SECRET to a long random value (never commit .env).
# - Run migrations: pnpm run db:migrate:deploy
# - Image uploads: host must allow request bodies up to your max image size (e.g. 5MB) on POST /api/admin/upload/product-image.
# - After changing R2_PUBLIC_BASE_URL or NEXT_PUBLIC_SITE_URL, restart the Node process so next.config picks up remotePatterns / CSP.
